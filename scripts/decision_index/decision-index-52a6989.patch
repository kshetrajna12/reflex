diff --git a/decision_index/engines/reflex_http.py b/decision_index/engines/reflex_http.py
new file mode 100644
index 0000000..bdec1b5
--- /dev/null
+++ b/decision_index/engines/reflex_http.py
@@ -0,0 +1,40 @@
+"""Decision Index HTTP adapter with Reflex capacity errors classified correctly.
+
+This keeps the canonical HTTP payload and response behavior.  The upstream generic
+adapter predates Reflex's exact validation message ("choice supports at most 26
+options"), so without this small adapter those declared capacity limits are recorded as
+retryable errors instead of terminal unsupported rows.  Both statuses score as wrong;
+the distinction matters for clean reporting and resume behavior.
+"""
+
+from decision_index.engines.base import Unsupported
+from decision_index.engines.http import CAPACITY_MARKERS, HttpSystemOne
+
+
+REFLEX_CAPACITY_MARKERS = CAPACITY_MARKERS + (
+    "choice supports at most",
+    "question branch too long",
+)
+
+
+class ReflexHttpSystemOne(HttpSystemOne):
+    name = "reflex-http"
+
+    def __call__(self, state, questions):
+        response = self.client.post(
+            "/v1/systemone",
+            json={
+                "model": self.model,
+                "state": state,
+                "questions": questions,
+                **self.extra,
+            },
+        )
+        if response.status_code in (400, 413, 422):
+            message = response.text
+            if any(marker in message for marker in REFLEX_CAPACITY_MARKERS):
+                raise Unsupported(message)
+        response.raise_for_status()
+        raw = response.json()
+        return {key: value for key, value in raw.items() if key != "evaluation_trace"}, raw
+
diff --git a/decision_index/parallel_runner.py b/decision_index/parallel_runner.py
new file mode 100644
index 0000000..79ff53c
--- /dev/null
+++ b/decision_index/parallel_runner.py
@@ -0,0 +1,271 @@
+import collections
+import gzip
+import hashlib
+import json
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor, as_completed
+from pathlib import Path
+
+from decision_index.runner import run
+from decision_index.suite.io import atomic_json, dumps, read_jsonl, sha256_file
+
+
+def _shard_number(run_id, workers):
+    digest = hashlib.sha256(run_id.encode("utf-8")).digest()
+    return int.from_bytes(digest[:8], "big") % workers
+
+
+def _layout(out, workers):
+    root = out / "_parallel"
+    return root, [root / f"shard-{i:03d}" for i in range(workers)]
+
+
+def _partition(rows_path, root, shard_dirs, expected):
+    root.mkdir(parents=True, exist_ok=True)
+    tmp_paths = [d.with_suffix(".rows.jsonl.gz.tmp") for d in shard_dirs]
+    final_paths = [d.with_suffix(".rows.jsonl.gz") for d in shard_dirs]
+    files = []
+    counts = [0] * len(shard_dirs)
+    try:
+        for path in tmp_paths:
+            files.append(gzip.open(path, "wt", encoding="utf-8", compresslevel=1))
+        for row in read_jsonl(rows_path):
+            run_id = row["_evaluation"]["run_id"]
+            shard = _shard_number(run_id, len(shard_dirs))
+            files[shard].write(dumps(row) + "\n")
+            counts[shard] += 1
+    finally:
+        for f in files:
+            f.close()
+    for tmp, final in zip(tmp_paths, final_paths):
+        tmp.replace(final)
+    manifest = {**expected, "rows": sum(counts), "rows_per_shard": counts, "seeded_from_results": False}
+    atomic_json(root / "manifest.json", manifest)
+    return manifest, final_paths
+
+
+def _prepare(rows_path, out, workers, engine_name, engine_options, resume):
+    root, shard_dirs = _layout(out, workers)
+    expected = {
+        "version": 1,
+        "workers": workers,
+        "shard_policy": "sha256(run_id)[0:8] modulo workers",
+        "source_rows_sha256": sha256_file(rows_path),
+        "engine": engine_name,
+        "engine_options": engine_options,
+    }
+    manifest_path = root / "manifest.json"
+    if manifest_path.exists():
+        if not resume:
+            raise ValueError("parallel --fresh requires a new output directory")
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        for key, value in expected.items():
+            if manifest.get(key) != value:
+                raise ValueError(
+                    f"parallel resume mismatch for {key}: "
+                    f"existing={manifest.get(key)!r}, requested={value!r}; use a new output directory"
+                )
+        shard_rows = [d.with_suffix(".rows.jsonl.gz") for d in shard_dirs]
+        missing = [str(p) for p in shard_rows if not p.exists()]
+        if missing:
+            raise FileNotFoundError(f"parallel shard rows are missing: {missing}")
+    else:
+        if root.exists() and any(root.iterdir()):
+            leftovers = list(root.iterdir())
+            if all(path.is_file() and ".rows.jsonl.gz" in path.name for path in leftovers):
+                for path in leftovers:
+                    path.unlink()
+            else:
+                raise ValueError(f"incomplete parallel state in {root}; use a new output directory")
+        if not resume and (out / "results.jsonl").exists():
+            raise ValueError("parallel --fresh requires an output directory without results.jsonl")
+        manifest, shard_rows = _partition(rows_path, root, shard_dirs, expected)
+
+    for directory in shard_dirs:
+        directory.mkdir(parents=True, exist_ok=True)
+
+    # A serial run can be continued in parallel without losing completed work.
+    # Seed exactly once; subsequent resumes use the shard checkpoints directly.
+    results_path = out / "results.jsonl"
+    if resume and results_path.exists() and not manifest.get("seeded_from_results"):
+        environment_path = out / "environment.json"
+        if environment_path.exists():
+            environment = json.loads(environment_path.read_text(encoding="utf-8"))
+            if environment.get("engine") != engine_name or environment.get("engine_options") != engine_options:
+                raise ValueError("existing results were produced by different engine options; use a new output directory")
+        handles = [(directory / "results.jsonl").open("a", encoding="utf-8") for directory in shard_dirs]
+        try:
+            for result in read_jsonl(results_path, complete_lines_only=True):
+                if result.get("engine") != engine_name:
+                    raise ValueError("existing results contain a different engine; use a new output directory")
+                shard = _shard_number(result["run_id"], workers)
+                handles[shard].write(dumps(result) + "\n")
+        finally:
+            for handle in handles:
+                handle.close()
+        manifest["seeded_from_results"] = True
+        atomic_json(manifest_path, manifest)
+    elif not manifest.get("seeded_from_results"):
+        manifest["seeded_from_results"] = True
+        atomic_json(manifest_path, manifest)
+    return root, shard_dirs, shard_rows, manifest
+
+
+def _has_pending(rows_path, results_path):
+    previous = {}
+    if results_path.exists():
+        for result in read_jsonl(results_path, complete_lines_only=True):
+            previous[result["run_id"]] = result["status"]
+    return any(
+        previous.get(row["_evaluation"]["run_id"]) in (None, "error")
+        for row in read_jsonl(rows_path)
+    )
+
+
+def _normalize_shard(rows_path, results_path, normalized_path):
+    latest = {}
+    if results_path.exists():
+        with results_path.open("r", encoding="utf-8") as source:
+            for line in source:
+                if not line.endswith("\n"):
+                    break
+                if line.strip():
+                    result = json.loads(line)
+                    latest[result["run_id"]] = line
+    with normalized_path.open("w", encoding="utf-8") as target:
+        for row in read_jsonl(rows_path):
+            line = latest.get(row["_evaluation"]["run_id"])
+            if line is not None:
+                target.write(line)
+
+
+def _merge(rows_path, out, root, shard_dirs, shard_rows, workers):
+    normalized = [root / f"shard-{i:03d}.canonical.jsonl" for i in range(workers)]
+    for rows, directory, target in zip(shard_rows, shard_dirs, normalized):
+        _normalize_shard(rows, directory / "results.jsonl", target)
+
+    handles = [path.open("r", encoding="utf-8") for path in normalized]
+    current = [None] * workers
+    counts = collections.Counter()
+    results_path = out / "results.jsonl"
+    tmp = results_path.with_suffix(results_path.suffix + ".tmp")
+    try:
+        with tmp.open("w", encoding="utf-8") as target:
+            for row in read_jsonl(rows_path):
+                run_id = row["_evaluation"]["run_id"]
+                shard = _shard_number(run_id, workers)
+                if current[shard] is None:
+                    line = handles[shard].readline()
+                    current[shard] = (json.loads(line), line) if line else False
+                item = current[shard]
+                if item and item[0]["run_id"] == run_id:
+                    target.write(item[1])
+                    counts[item[0]["status"]] += 1
+                    current[shard] = None
+        tmp.replace(results_path)
+    finally:
+        for handle in handles:
+            handle.close()
+        for path in normalized:
+            path.unlink(missing_ok=True)
+        tmp.unlink(missing_ok=True)
+    return counts
+
+
+def run_parallel(
+    engine_name,
+    engine_options,
+    rows_path,
+    out_dir,
+    workers,
+    compact=False,
+    resume=True,
+    warm=True,
+    seed=20260919,
+    corpus_sha256=None,
+    halt_on_device_error=True,
+    log=print,
+):
+    """Run deterministic serial shards concurrently, then merge canonical results.
+
+    Each shard uses the official runner unchanged.  Its per-request timing therefore
+    remains the wall time measured around the engine call; queueing and merge time are
+    not added to request latency.
+    """
+    workers = int(workers)
+    if workers < 2:
+        raise ValueError("run_parallel requires at least two workers")
+    rows_path = Path(rows_path)
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    root, shard_dirs, shard_rows, manifest = _prepare(
+        rows_path, out, workers, engine_name, engine_options, resume
+    )
+    lock = threading.Lock()
+
+    def worker(shard):
+        rows = shard_rows[shard]
+        directory = shard_dirs[shard]
+        if not _has_pending(rows, directory / "results.jsonl"):
+            return {"event": "complete", "completed": manifest["rows_per_shard"][shard], "counts": {}}
+
+        def worker_log(message):
+            with lock:
+                log(message)
+
+        return run(
+            engine_name,
+            engine_options,
+            rows,
+            directory,
+            compact=compact,
+            resume=True,
+            warm=warm,
+            seed=seed + shard,
+            corpus_sha256=corpus_sha256,
+            halt_on_device_error=halt_on_device_error,
+            log=worker_log,
+        )
+
+    started = time.perf_counter()
+    atomic_json(
+        out / "status.json",
+        {"event": "running", "engine": engine_name, "workers": workers, "rows": manifest["rows"]},
+        indent=None,
+    )
+    failures = []
+    with ThreadPoolExecutor(max_workers=workers, thread_name_prefix="decision-index") as executor:
+        futures = {executor.submit(worker, shard): shard for shard in range(workers)}
+        for future in as_completed(futures):
+            try:
+                future.result()
+            except Exception as exc:
+                failures.append((futures[future], exc))
+
+    counts = _merge(rows_path, out, root, shard_dirs, shard_rows, workers)
+    environment_source = next((d / "environment.json" for d in shard_dirs if (d / "environment.json").exists()), None)
+    if environment_source:
+        environment = json.loads(environment_source.read_text(encoding="utf-8"))
+        environment["rows_path"] = str(rows_path)
+        environment["parallel"] = {
+            "workers": workers,
+            "shard_policy": manifest["shard_policy"],
+            "parallel_runner_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        }
+        atomic_json(out / "environment.json", environment)
+    status = {
+        "event": "failed" if failures else "complete",
+        "engine": engine_name,
+        "workers": workers,
+        "completed": sum(counts.values()),
+        "counts": dict(counts),
+        "elapsed_seconds": round(time.perf_counter() - started, 1),
+    }
+    if failures:
+        status["errors"] = [{"shard": shard, "error": str(exc)} for shard, exc in failures]
+    atomic_json(out / "status.json", status, indent=None)
+    log(dumps(status))
+    if failures:
+        raise RuntimeError(f"{len(failures)} parallel shard(s) failed; checkpoints and merged results were preserved") from failures[0][1]
+    return status
